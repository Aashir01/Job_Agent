{
  "manifest_version": 3,
  "name": "job-agent filler",
  "version": "0.1.0",
  "description": "Fills approved applications into career pages in your own session. It never clicks Submit — you do.",
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "host_permissions": [
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://apply.workable.com/*",
    "https://jobs.smartrecruiters.com/*",
    "https://www.linkedin.com/jobs/*",
    "https://www.indeed.com/*",
    "https://*.indeed.com/*"
  ],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_popup": "src/popup.html", "default_title": "job-agent" },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://apply.workable.com/*",
        "https://jobs.smartrecruiters.com/*"
      ],
      "js": ["src/fill.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/jobs/*", "https://*.indeed.com/*"],
      "js": ["src/harvest.js"],
      "run_at": "document_idle"
    }
  ]
}
