# ── Supabase ──────────────────────────────────────────────────────────────
# The service key bypasses RLS. It lives on the API machine and in GitHub
# Actions secrets only — never in the dashboard bundle or the extension.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# Shared secret for machine routes. Generate with: openssl rand -hex 32
AGENT_KEY=

ENVIRONMENT=prod
LOG_LEVEL=INFO
CORS_ORIGINS=https://your-dashboard.vercel.app

# ── LLM providers (§8) ────────────────────────────────────────────────────
# OpenRouter is tried first when its key is set; Gemini then Groq are the
# fallbacks. Any one of the three is enough to run a batch.
OPENROUTER_API_KEY=
OPENROUTER_CHEAP_MODEL=inclusionai/ling-3.0-flash-fin:free
OPENROUTER_GOOD_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FALLBACK_MODELS=poolside/laguna-s-2.1:free,nvidia/nemotron-3-ultra-550b-a55b:free
# Reasoning models spend the whole token budget thinking and never emit the JSON.
OPENROUTER_DISABLE_REASONING=true

GEMINI_API_KEY=
GROQ_API_KEY=
LLM_CALLS_PER_BATCH=300

# 'hashing' needs no key and fits a 256MB machine. 'gemini' costs quota.
EMBEDDING_PROVIDER=hashing

# ── Hard caps (§10) ───────────────────────────────────────────────────────
MAX_OUTBOUND_EMAILS_PER_DAY=30
MAX_EXTENSION_SUBMITS_PER_DAY=20

# ── Priority weighting (§2) ───────────────────────────────────────────────
WEIGHT_REMOTE_FTE=1.00
WEIGHT_RELOCATION=0.70
WEIGHT_CONTRACT=0.40

# ── Review tiers (§7) ─────────────────────────────────────────────────────
TIER_FAST_LANE_MIN=85
TIER_STANDARD_MIN=70
TIER_MARGINAL_MIN=60

# ── Notifications ─────────────────────────────────────────────────────────
# After every run a digest is pushed: what was built, the top matches with
# scores and links, and a link back to the queue. Set at least one channel, or
# every run is silent and you have to remember to look.
#
# Telegram is the easiest: message @BotFather for a token, send your new bot any
# message (a bot cannot open a conversation with you), then @userinfobot for
# your numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Any URL taking a JSON POST. WhatsApp has no free first-party API — reach it
# through a relay such as CallMeBot. The digest text is also sent as ?text= so
# relays of either shape work.
NOTIFY_WEBHOOK_URL=

# Digest by email, via Resend. Never spends the daily outbound-application cap.
NOTIFY_EMAIL=

# Where the dashboard lives, so a digest can link to the queue.
DASHBOARD_URL=

NOTIFY_TOP_N=8
NOTIFY_ON_EMPTY=false
NOTIFY_ON_ERROR=true

# ── Optional integrations ─────────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=
HUNTER_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Gmail reply detection (§6 Chaser). Read-only scope is enough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Override when the Home Office rotates the register filename.
REGISTER_URL_UK=
REGISTER_URL_NL=
REGISTER_URL_CA=
